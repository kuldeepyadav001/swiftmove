# Copy this file to backend/.env and fill real values.
# Do NOT commit backend/.env.

mongodb_uri=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/swiftmove?retryWrites=true&w=majority

jwt_secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
jwt_expiration=86400000

# Local Docker/frontend dev. Add your Netlify URL for production, comma separated if needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app

ors_api_key=NOT_SET

mail_username=your_email@gmail.com
mail_password=your_gmail_app_password

razorpay_id=NOT_SET
razorpay_secret=NOT_SET
