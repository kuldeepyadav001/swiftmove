# Root gitignore for SwiftMove monorepo

# Secrets & environment — NEVER commit these
.env
.env.*
!.env.example
!.env.*.example

# SSH keys
*.pem
*.key
.ssh/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Build artifacts
backend/target/
frontend/dist/
frontend/node_modules/
backend/node_modules/

# Maven wrapper jar
.mvn/wrapper/maven-wrapper.jar

# Log files
*.log
